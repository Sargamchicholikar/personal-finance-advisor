{
  "version": 2,
  "builds": [
    { "src": "api/main.py", "use": "@vercel/python" },
    { "src": "web/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/health", "dest": "api/main.py" },
    { "src": "/analyze", "dest": "api/main.py" },
    { "src": "/chat", "dest": "api/main.py" },
    { "src": "/expense/analyze-csv", "dest": "api/main.py" },
    { "src": "/expense/predict", "dest": "api/main.py" },
    { "src": "/", "dest": "/web/index.html" },
    { "src": "/(.*)", "dest": "/web/$1" }
  ]
}
